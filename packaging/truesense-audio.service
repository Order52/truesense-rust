[Unit]
Description=TrueSense audio: Purified Voice filter selection on headset plug/unplug
After=pipewire.service wireplumber.service
# never give up restarting: a crash loop at this pace costs nothing, a service that stays failed leaves the keys or the filters dead until the next login
StartLimitIntervalSec=0

[Service]
ExecStart=@PREFIX@/bin/truesense audio voice watch
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
