# TrueSense device access. `uaccess` gives the user logged in on the laptop's seat access (no groups to manage); root always has it.
KERNEL=="truesense", SUBSYSTEM=="misc", TAG+="uaccess", MODE="0660"
# keyboard HID interfaces (lighting, Fn / PREDATOR key reports): Chicony 04f2:0117
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04f2", ATTRS{idProduct}=="0117", TAG+="uaccess"
