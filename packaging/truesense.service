[Unit]
Description=TrueSense: fans, power modes and automation for the Acer Predator Helios 16 (PH16-71)
After=systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=20
RuntimeDirectory=truesense
StateDirectory=truesense
ExecStartPre=-@MODPROBE@ truesense_wmi
ExecStart=@PREFIX@/bin/truesense daemon
# however it ends (crash, kill, hang, stop, update): fans back to firmware control, clocks uncapped
ExecStopPost=-@PREFIX@/bin/truesense fan auto
ExecStopPost=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_max_freq; do cat "$(dirname $f)/cpuinfo_max_freq" > $f; done; true'
Restart=always
RestartSec=1
Nice=-5
OOMScoreAdjust=-900
# hardening (the daemon must write sysfs power/cpufreq files, so kernel tunables stay writable)
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=no
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
